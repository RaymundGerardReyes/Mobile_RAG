{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["src/domain/*"],
      "@application/*": ["src/application/*"],
      "@data/*": ["src/data/*"],
      "@ai/*": ["src/ai/*"],
      "@diagnostics/*": ["src/diagnostics/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}

