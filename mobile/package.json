{
  "name": "ai-tutor-mobile",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "clean:port": "npx --yes kill-port 8081",
    "tunnel": "npx expo start --tunnel",
    "tunnel:go": "expo start --tunnel --go",
    "expo:ios": "expo start --tunnel --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/tests/**/*.test.js"
  },
  "dependencies": {
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.35",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "typescript": "^5.6.0"
  }
}
