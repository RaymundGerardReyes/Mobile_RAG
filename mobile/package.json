{
  "name": "ai-tutor-mobile",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "clean:port": "npx --yes kill-port 8081",
    "go": "expo start --go",
    "lan": "expo start --lan --go",
    "tunnel": "npx expo start --tunnel",
    "tunnel:go": "expo start --tunnel --go",
    "expo:ios": "expo start --go",
    "expo:ios:tunnel": "expo start --tunnel --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/tests/**/*.test.js"
  },
  "dependencies": {
    "babel-preset-expo": "~57.0.16",
    "expo": "~57.0.30",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "typescript": "^5.6.0"
  }
}
