{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extracted-page",
  "type": "object",
  "required": ["source_id", "page_number", "chapter", "section", "text"],
  "properties": {
    "source_id": {
      "type": "string",
      "description": "SHA-256 prefix of source PDF"
    },
    "page_number": {
      "type": "integer",
      "minimum": 1
    },
    "chapter": {
      "type": ["string", "null"]
    },
    "section": {
      "type": ["string", "null"]
    },
    "text": {
      "type": "string"
    },
    "is_empty": {
      "type": "boolean",
      "default": false
    },
    "empty_reason": {
      "type": ["string", "null"]
    },
    "headings_detected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
